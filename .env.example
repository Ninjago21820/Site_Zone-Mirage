# ---------------------------------------------------------------------------
# SCP: Mirage Protocol — configuration de production
# Copier en `.env` (jamais versionné) puis renseigner les valeurs réelles.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Origine publique exacte (cookies __Host-, liens des e-mails, WebAuthn)
PUBLIC_ORIGIN=https://www.mirage-protocol.example
ADMIN_PATH=/console-mirage
WEBAUTHN_RP_ID=mirage-protocol.example

# --- Base de données -------------------------------------------------------
# MySQL/MariaDB (production). Exemple :
# DATABASE_URL=mysql://mirage:motdepasse@db-host:3306/mirage_protocol
DATABASE_URL=
# Variante par champs (si DATABASE_URL n'est pas utilisée)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
DB_SSL=false
DB_POOL_SIZE=10

# Développement/tests uniquement (ignoré si DATABASE_URL est défini)
# DB_PATH=./data/mirage.db

# --- Sauvegardes chiffrées (§6.11) ----------------------------------------
# Clé de 32+ caractères minimum ; sans elle, une clé locale est générée dans
# BACKUP_DIR (.backup-key) et doit être sauvegardée séparément : sans elle les
# archives .zmbk1 sont définitivement illisibles.
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=./data/backups

# --- E-mails transactionnels ----------------------------------------------
SMTP_URL=smtp://utilisateur:motdepasse@smtp.example:587
MAIL_FROM="SCP: Mirage Protocol <no-reply@mirage-protocol.example>"
SUPPORT_EMAIL=support@mirage-protocol.example

# --- Fournisseurs OAuth2 / OIDC (§5.1) ------------------------------------
# Un fournisseur sans CLIENT_ID/SECRET reste inactif : l'API répond
# 503 provider_not_configured et le bouton est désactivé côté interface.
# Discord et Google ont des endpoints par défaut ; Steam (OpenID) et Epic (EOS)
# exigent les trois URL ci-dessous en plus des identifiants.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# DISCORD_AUTHORIZE_URL= / DISCORD_TOKEN_URL= / DISCORD_USERINFO_URL= / DISCORD_SCOPES=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_AUTHORIZE_URL= / GOOGLE_TOKEN_URL= / GOOGLE_USERINFO_URL= / GOOGLE_SCOPES=

STEAM_CLIENT_ID=
STEAM_CLIENT_SECRET=
STEAM_AUTHORIZE_URL=
STEAM_TOKEN_URL=
STEAM_USERINFO_URL=

EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
EPIC_AUTHORIZE_URL=
EPIC_TOKEN_URL=
EPIC_USERINFO_URL=

OAUTH_TIMEOUT_MS=8000

# --- Vérification des licences (§5.4) -------------------------------------
STEAM_WEB_API_KEY=
STEAM_APP_ID=
EPIC_VERIFIER_URL=
PLATFORM_TIMEOUT_MS=4000

# --- Anti-robot (§6.7) -----------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Discord (interactions signées Ed25519, §12.3) ------------------------
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=

# --- Internationalisation (§12.1) -----------------------------------------
I18N_THRESHOLD=0.85
